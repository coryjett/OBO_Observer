# Optional overrides for ./demo_env.sh and for local runs.
# Copy to .env and set values as needed:  cp .env.example .env
# .env is gitignored; do not commit secrets.

# --- Required for demo_env.sh (no default) ---
# AGENTGATEWAY_LICENSE_KEY=<your-solo-enterprise-license-key>

# --- Optional: demo_env.sh and cluster ---
# KUBE_CONTEXT=my-k3d-cluster
# ENTERPRISE_AGENTGATEWAY_VERSION=2.1.0
# GATEWAY_API_VERSION=v1.4.0
# KEYCLOAK_REALM=oidc-realm
# KEYCLOAK_CLIENT_ID=agw-client
# KEYCLOAK_CLIENT_SECRET=agw-client-secret
# KEYCLOAK_USERNAME=testuser
# KEYCLOAK_PASSWORD=testuser
# KAGENT_TOOLS_VERSION=0.0.13

# --- Optional: resolve client IP to workload name in Contexts/Trace (LOG_MODE=kubernetes) ---
# "*" = list pods in all namespaces (default). Or comma-separated: obo-observer,default
# CLIENT_RESOLVE_NAMESPACES=*

# --- Deploy to a REAL Kubernetes cluster (scripts/deploy-k8s.sh) ---
# Registry image (required) + how to expose it, and which gateway to observe.
# IMAGE=docker.io/you/obo-observer:latest
# BUILD=1                       # 1 = buildx build+push; 0 = image already in registry
# PLATFORM=linux/amd64          # cluster node arch
# IMAGE_PULL_POLICY=Always
# SERVICE_TYPE=LoadBalancer     # or ClusterIP / NodePort
# GATEWAY_NAMESPACE=ingress     # namespace of the agentgateway data-plane pods (log source)
# GATEWAY_LABEL_SELECTOR=gateway.networking.k8s.io/gateway-name=internal-gateway
# KUBE_CONTEXT=my-cluster       # optional; defaults to current context
# --- Optional interactive OBO flow / Agent Chat (leave empty for Observer-only) ---
# BASE_URL=http://<lb-ip>       # browser-reachable app URL; register <BASE_URL>/auth/callback in IdP
# KEYCLOAK_URL=http://<idp>     # browser-reachable IdP
# KEYCLOAK_INTERNAL_URL=http://keycloak.keycloak.svc.cluster.local:8080
# OAUTH2_CLIENT_ID=obo-observer
# OAUTH2_CLIENT_SECRET=obo-observer-secret
# OPENAI_BASE_URL=http://enterprise-agentgateway.<ns>.svc.cluster.local/openai

# --- Optional: OpenAI API key (server-side; never sent to the browser) ---
# When set, the UI hides the API key field. Local: app loads .env at startup from project root.
# Kubernetes: ./demo_env.sh creates the secret from .env; then restart deployment once after deploy.
# https://docs.solo.io/agentgateway/2.1.x/llm/api-keys/#api-key
# OPENAI_API_KEY=sk-...
